// Included inside NativeSfs's private namespace; all metadata uses its existing
// state lock. Diagnostic exceptions are contained, never converted to Vulkan
// errors. Journal labels distinguish game handles from transformed SFS handles.
namespace tc=kharvox::temporal_context;
template<class F> void observe(const std::shared_ptr<State>& s,F&& action)noexcept{
    if(s->context&&!s->context->capture->finished())s->context->capture->protect([&]{action(*s->context->capture,*s->context);});
}
std::string contextCommand(const CommandState& c,VkCommandBuffer cb){return "\"command\":"+std::to_string(tc::handle(cb))+",\"allocation\":"+std::to_string(c.contextAllocation)+",\"generation\":"+std::to_string(c.auditGeneration);}
void contextImage(const std::shared_ptr<State>& s,VkImage id,const VkImageCreateInfo& i){observe(s,[&](auto& c,auto&){
    if(i.pNext)c.gap("image-create-extension");std::ostringstream o;o<<"{\"format\":"<<i.format<<",\"extent\":["<<i.extent.width<<','<<i.extent.height<<','<<i.extent.depth<<"],\"layers\":"<<i.arrayLayers<<",\"mips\":"<<i.mipLevels<<",\"samples\":"<<i.samples<<",\"usage\":"<<i.usage<<",\"flags\":"<<i.flags<<",\"type\":"<<i.imageType<<",\"tiling\":"<<i.tiling<<",\"initialLayout\":"<<i.initialLayout<<",\"sharing\":"<<i.sharingMode<<",\"families\":"<<tc::numbers(i.pQueueFamilyIndices,i.queueFamilyIndexCount)<<'}';c.define("image",tc::handle(id),o.str());
});}
void contextView(const std::shared_ptr<State>& s,VkImageView id,const VkImageViewCreateInfo& i){observe(s,[&](auto& c,auto&){
    if(i.pNext)c.gap("image-view-extension");const VkComponentSwizzle swizzle[]={i.components.r,i.components.g,i.components.b,i.components.a};c.define("view",tc::handle(id),"{\"image\":"+std::to_string(tc::handle(i.image))+",\"format\":"+std::to_string(i.format)+",\"type\":"+std::to_string(i.viewType)+",\"range\":"+tc::range(i.subresourceRange)+",\"swizzle\":"+tc::numbers(swizzle,4)+"}");
});}
void contextPipeline(const std::shared_ptr<State>& s,VkPipeline id,VkPipeline stereo,const VkGraphicsPipelineCreateInfo& i){observe(s,[&](auto& c,auto&){
    if(i.pNext)c.gap("graphics-pipeline-extension");std::ostringstream o;o<<"{\"point\":0,\"stereo\":"<<tc::handle(stereo)<<",\"layout\":"<<tc::handle(i.layout)<<",\"pass\":"<<tc::handle(i.renderPass)<<",\"subpass\":"<<i.subpass<<",\"stages\":[";const auto seed=pipelineSeed(i);
    for(uint32_t n=0;n<i.stageCount;++n){const auto& stage=i.pStages[n];const auto& words=s->shaders.at(stage.module);o<<(n?",":"")<<"{\"stage\":"<<stage.stage<<",\"hash\":"<<tc::quote(shaderKey(profileHash(words.data(),uint32_t(words.size()*4))))<<",\"variant\":"<<tc::quote(shaderKey(profileHash(words.data(),uint32_t(words.size()*4),seed)))<<",\"entry\":"<<tc::quote(stage.pName?stage.pName:"")<<'}';if(stage.pNext||stage.pSpecializationInfo)c.gap("pipeline-stage-specialization-or-extension");}
    o<<"],\"dynamic\":"<<tc::numbers(i.pDynamicState?i.pDynamicState->pDynamicStates:nullptr,i.pDynamicState?i.pDynamicState->dynamicStateCount:0);
    bool dynamicViewport=false,dynamicScissor=false;if(i.pDynamicState)for(uint32_t n=0;n<i.pDynamicState->dynamicStateCount;++n){dynamicViewport|=i.pDynamicState->pDynamicStates[n]==VK_DYNAMIC_STATE_VIEWPORT;dynamicScissor|=i.pDynamicState->pDynamicStates[n]==VK_DYNAMIC_STATE_SCISSOR;}
    o<<",\"viewportsBits\":[";if(i.pViewportState&&!dynamicViewport&&i.pViewportState->pViewports)for(uint32_t n=0;n<i.pViewportState->viewportCount;++n)o<<(n?",":"")<<tc::bits(&i.pViewportState->pViewports[n].x,6);o<<"],\"scissors\":[";if(i.pViewportState&&!dynamicScissor&&i.pViewportState->pScissors)for(uint32_t n=0;n<i.pViewportState->scissorCount;++n)o<<(n?",":"")<<tc::rect(i.pViewportState->pScissors[n]);
    o<<"],\"depth\":";if(i.pDepthStencilState){const auto& d=*i.pDepthStencilState;o<<'['<<d.depthTestEnable<<','<<d.depthWriteEnable<<','<<d.depthCompareOp<<','<<d.depthBoundsTestEnable<<','<<d.stencilTestEnable<<']';}else o<<"null";
    o<<",\"blend\":[";if(i.pColorBlendState)for(uint32_t n=0;n<i.pColorBlendState->attachmentCount;++n){const auto& b=i.pColorBlendState->pAttachments[n];o<<(n?",":"")<<'['<<b.blendEnable<<','<<b.srcColorBlendFactor<<','<<b.dstColorBlendFactor<<','<<b.colorBlendOp<<','<<b.srcAlphaBlendFactor<<','<<b.dstAlphaBlendFactor<<','<<b.alphaBlendOp<<','<<b.colorWriteMask<<']';}o<<"]}";c.define("pipeline",tc::handle(id),o.str());
});}
void contextDraw(const std::shared_ptr<State>& s,VkCommandBuffer cb,const char* kind){observe(s,[&](auto& capture,auto&){
    if(!capture.active())return;const auto& c=commandOf(s,cb);std::ostringstream o;o<<'{'<<contextCommand(c,cb)<<",\"draw\":"<<c.auditDraw<<",\"kind\":"<<tc::quote(kind)<<",\"recordedFrame\":"<<s->renderPose.serial<<",\"pipeline\":"<<tc::handle(c.graphics)<<",\"stereo\":"<<(c.stereo?"true":"false")<<",\"pass\":"<<tc::handle(c.auditPass)<<",\"actualPass\":"<<tc::handle(c.stereo?s->passes.at(c.auditPass):c.auditPass)<<",\"framebuffer\":"<<tc::handle(c.auditFramebuffer)<<",\"subpass\":"<<c.auditSubpass<<",\"area\":"<<tc::rect(c.auditArea)<<",\"sets\":[";
    bool comma=false;for(size_t n=0;n<c.descriptors.size();++n){const auto& d=c.descriptors[n];if(!d.set)continue;o<<(comma?",":"")<<"{\"index\":"<<n<<",\"set\":"<<tc::handle(d.set)<<",\"layout\":"<<tc::handle(d.layout)<<",\"offsets\":"<<tc::numbers(d.dynamic.data(),d.dynamic.size())<<'}';comma=true;}
    o<<"],\"viewportsBits\":[";for(size_t n=0;n<c.bindings.viewports.size();++n){const auto& v=c.bindings.viewports[n];o<<(n?",":"")<<(v.valid?tc::bits(&v.value.x,6):"null");}o<<"],\"scissors\":[";for(size_t n=0;n<c.bindings.scissors.size();++n){const auto& v=c.bindings.scissors[n];o<<(n?",":"")<<(v.valid?tc::rect(v.value):"null");}o<<"]}";capture.event("draw",o.str());
});}
void contextEvent(const std::shared_ptr<State>& s,VkCommandBuffer cb,const char* kind,const std::string& fields){observe(s,[&](auto& c,auto&){if(c.active())c.event(kind,"{"+contextCommand(commandOf(s,cb),cb)+(fields.empty()?"":","+fields)+"}");});}
void contextBarriers(const std::shared_ptr<State>& s,VkCommandBuffer cb,VkPipelineStageFlags src,VkPipelineStageFlags dst,VkDependencyFlags flags,uint32_t nm,const VkMemoryBarrier* m,uint32_t nb,const VkBufferMemoryBarrier* b,uint32_t ni,const VkImageMemoryBarrier* i){observe(s,[&](auto& c,auto&){
    if(!c.active())return;std::ostringstream o;o<<"\"src\":"<<src<<",\"dst\":"<<dst<<",\"flags\":"<<flags<<",\"memory\":[";
    for(uint32_t n=0;n<nm;++n){o<<(n?",":"")<<'['<<m[n].srcAccessMask<<','<<m[n].dstAccessMask<<']';if(m[n].pNext)c.gap("memory-barrier-extension");}o<<"],\"buffers\":[";
    for(uint32_t n=0;n<nb;++n){const auto& v=b[n];o<<(n?",":"")<<'['<<tc::handle(v.buffer)<<','<<v.offset<<','<<v.size<<','<<v.srcAccessMask<<','<<v.dstAccessMask<<','<<v.srcQueueFamilyIndex<<','<<v.dstQueueFamilyIndex<<']';if(v.pNext)c.gap("buffer-barrier-extension");}o<<"],\"images\":[";
    for(uint32_t n=0;n<ni;++n){const auto& v=i[n];o<<(n?",":"")<<"{\"image\":"<<tc::handle(v.image)<<",\"range\":"<<tc::range(v.subresourceRange)<<",\"old\":"<<v.oldLayout<<",\"new\":"<<v.newLayout<<",\"src\":"<<v.srcAccessMask<<",\"dst\":"<<v.dstAccessMask<<",\"srcFamily\":"<<v.srcQueueFamilyIndex<<",\"dstFamily\":"<<v.dstQueueFamilyIndex<<'}';if(v.pNext)c.gap("image-barrier-extension");}o<<']';contextEvent(s,cb,"barrier",o.str());
});}
void contextTransfer(const std::shared_ptr<State>& s,VkCommandBuffer cb,const char* kind,VkImage src,VkImageLayout sl,VkImage dst,VkImageLayout dl){observe(s,[&](auto&,auto&){contextEvent(s,cb,kind,"\"source\":"+std::to_string(tc::handle(src))+",\"destination\":"+std::to_string(tc::handle(dst))+",\"sourceLayout\":"+std::to_string(sl)+",\"destinationLayout\":"+std::to_string(dl)+",\"regionsQualified\":false");});}
